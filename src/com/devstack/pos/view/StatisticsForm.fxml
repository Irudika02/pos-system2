<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="context" prefHeight="496.0" prefWidth="699.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.devstack.pos.controller.StatisticsFormController">
   <children>
      <Label layoutX="14.0" layoutY="15.0" text="Statistics &amp; Sales Analytics" textFill="#ab0404">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Separator layoutX="14.0" layoutY="42.0" prefHeight="4.0" prefWidth="669.0" />
      <Button layoutX="575.0" layoutY="14.0" mnemonicParsing="false" onAction="#BackToDashboardOnAction" prefHeight="25.0" prefWidth="108.0" style="-fx-background-color: #747d8c;" text="← Back" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>

      <Button layoutX="14.0" layoutY="54.0" mnemonicParsing="false" onAction="#LoadDataOnAction" prefHeight="25.0" prefWidth="120.0" style="-fx-background-color: #6ab04c;" text="Refresh Stats" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>

      <AreaChart fx:id="chartRevenue" layoutX="14.0" layoutY="90.0" prefHeight="388.0" prefWidth="669.0">
        <xAxis>
          <CategoryAxis label="Orders" side="BOTTOM" />
        </xAxis>
        <yAxis>
          <NumberAxis label="Revenue (LKR)" side="LEFT" />
        </yAxis>
      </AreaChart>
   </children>
</AnchorPane>
