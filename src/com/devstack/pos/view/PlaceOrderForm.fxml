<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="context" prefHeight="436.0" prefWidth="699.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.devstack.pos.controller.PlaceOrderFormController">
   <children>
      <Label fx:id="lblOrderId" layoutX="14.0" layoutY="15.0" text="Place Order (Order ID: #001)" textFill="#ab0404">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Separator layoutX="14.0" layoutY="42.0" prefHeight="4.0" prefWidth="669.0" />
      <Button layoutX="450.0" layoutY="15.0" mnemonicParsing="false" onAction="#BackToDashboardOnAction" prefHeight="25.0" prefWidth="110.0" style="-fx-background-color: #747d8c;" text="← Back" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button layoutX="576.0" layoutY="15.0" mnemonicParsing="false" onAction="#NewOrderOnAction" prefHeight="25.0" prefWidth="108.0" style="-fx-background-color: #6ab04c;" text="+ New Order" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>

      <Label layoutX="15.0" layoutY="54.0" text="Customer Details">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="txtCustomerId" layoutX="15.0" layoutY="77.0" prefHeight="25.0" prefWidth="139.0" promptText="Customer Id (Enter)" />
      <TextField fx:id="txtCustomerName" editable="false" layoutX="169.0" layoutY="77.0" prefHeight="25.0" prefWidth="172.0" promptText="Customer Name" />
      <TextField fx:id="txtCustomerSalary" editable="false" layoutX="358.0" layoutY="77.0" prefHeight="25.0" prefWidth="108.0" promptText="Customer Salary" />
      <TextField fx:id="txtCustomerAddress" editable="false" layoutX="482.0" layoutY="77.0" prefHeight="25.0" prefWidth="202.0" promptText="Customer Address" />

      <Label layoutX="15.0" layoutY="112.0" text="Product Details">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      <TextField fx:id="txtProductCode" layoutX="14.0" layoutY="140.0" prefHeight="25.0" prefWidth="139.0" promptText="Product Code (Enter)" />
      <TextField fx:id="txtProductDescription" editable="false" layoutX="168.0" layoutY="140.0" prefHeight="25.0" prefWidth="172.0" promptText="Product Description" />
      <TextField fx:id="txtUnitPrice" editable="false" layoutX="357.0" layoutY="140.0" prefHeight="25.0" prefWidth="108.0" promptText="Unit Price" />
      <TextField fx:id="txtQtyOnHand" editable="false" layoutX="481.0" layoutY="140.0" prefHeight="25.0" prefWidth="110.0" promptText="QTY On Hand" />
      <TextField fx:id="txtQty" layoutX="600.0" layoutY="140.0" onAction="#QTYOnAction" prefHeight="25.0" prefWidth="84.0" promptText="QTY" />

      <Button layoutX="575.0" layoutY="175.0" mnemonicParsing="false" onAction="#AddToCartOnAction" prefHeight="25.0" prefWidth="108.0" style="-fx-background-color: #6ab04c;" text="+ Add To Cart" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>

      <TableView fx:id="tblCart" layoutX="15.0" layoutY="209.0" prefHeight="158.0" prefWidth="669.0">
        <columns>
          <TableColumn fx:id="colCode" prefWidth="100.0" text="Code" />
          <TableColumn fx:id="colDescription" prefWidth="220.0" text="Description" />
          <TableColumn fx:id="colUnitPrice" prefWidth="110.0" text="Unit Price" />
          <TableColumn fx:id="colQty" prefWidth="90.0" text="QTY" />
          <TableColumn fx:id="colTotal" prefWidth="145.0" text="Total" />
        </columns>
      </TableView>

      <Label fx:id="lblTotal" layoutX="20.0" layoutY="382.0" text="Total: LKR 0.00" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>

      <Button layoutX="538.0" layoutY="382.0" mnemonicParsing="false" onAction="#PlaceOrderOnAction" prefHeight="30.0" prefWidth="145.0" style="-fx-background-color: #3742fa;" text="Place Order" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
</AnchorPane>
