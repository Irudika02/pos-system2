<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="context" prefHeight="400.0" prefWidth="699.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.devstack.pos.controller.OrderHistoryFormController">
   <children>
      <Label layoutX="14.0" layoutY="15.0" text="Order History" textFill="#ab0404">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Separator layoutX="14.0" layoutY="42.0" prefHeight="4.0" prefWidth="669.0" />
      <Button layoutX="575.0" layoutY="14.0" mnemonicParsing="false" onAction="#BackToDashboardOnAction" prefHeight="25.0" prefWidth="108.0" style="-fx-background-color: #747d8c;" text="← Back" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <TextField fx:id="txtSearch" layoutX="14.0" layoutY="54.0" prefHeight="25.0" prefWidth="250.0" promptText="Filter by Order ID / Customer..." />
      <TableView fx:id="tblOrders" layoutX="15.0" layoutY="93.0" prefHeight="287.0" prefWidth="669.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="120.0" text="Order ID" />
          <TableColumn fx:id="colCustomer" prefWidth="140.0" text="Customer ID" />
          <TableColumn fx:id="colTotal" prefWidth="130.0" text="Total Cost (LKR)" />
          <TableColumn fx:id="colDate" prefWidth="160.0" text="Date &amp; Time" />
          <TableColumn fx:id="colUser" prefWidth="118.0" text="User Email" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
