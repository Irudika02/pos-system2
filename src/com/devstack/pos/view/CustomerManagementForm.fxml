<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="context" prefHeight="400.0" prefWidth="699.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.devstack.pos.controller.CustomerManagementFormController">
   <children>
      <Label layoutX="14.0" layoutY="15.0" text="Customer Management" textFill="#ab0404">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Separator layoutX="14.0" layoutY="42.0" prefHeight="4.0" prefWidth="669.0" />
      <Button layoutX="450.0" layoutY="15.0" mnemonicParsing="false" onAction="#BackToDashboardOnAction" prefHeight="25.0" prefWidth="110.0" style="-fx-background-color: #747d8c;" text="← Back" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button layoutX="576.0" layoutY="15.0" mnemonicParsing="false" onAction="#NewCustomerOnAction" prefHeight="25.0" prefWidth="108.0" style="-fx-background-color: #3742fa;" text="+ New Customer" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <TextField fx:id="txtId" editable="false" layoutX="14.0" layoutY="54.0" prefHeight="25.0" prefWidth="130.0" promptText="Customer Id" />
      <TextField fx:id="txtName" layoutX="155.0" layoutY="54.0" prefHeight="25.0" prefWidth="170.0" promptText="Customer Name" />
      <TextField fx:id="txtAddress" layoutX="335.0" layoutY="54.0" prefHeight="25.0" prefWidth="200.0" promptText="Customer Address" />
      <TextField fx:id="txtSalary" layoutX="545.0" layoutY="54.0" prefHeight="25.0" prefWidth="139.0" promptText="Customer Salary" />
      <TextField fx:id="txtSearch" layoutX="14.0" layoutY="89.0" prefHeight="25.0" prefWidth="502.0" promptText="Search Customer by Name..." />
      <Button fx:id="btnSave" layoutX="539.0" layoutY="89.0" mnemonicParsing="false" onAction="#SaveCustomerOnAction" prefHeight="25.0" prefWidth="145.0" style="-fx-background-color: #3742fa;" text="Save Customer" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <TableView fx:id="tblCustomer" layoutX="15.0" layoutY="124.0" prefHeight="258.0" prefWidth="669.0">
        <columns>
          <TableColumn fx:id="colId" prefWidth="120.0" text="Customer ID" />
          <TableColumn fx:id="colName" prefWidth="180.0" text="Name" />
          <TableColumn fx:id="colAddress" prefWidth="240.0" text="Address" />
          <TableColumn fx:id="colSalary" prefWidth="128.0" text="Salary" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
