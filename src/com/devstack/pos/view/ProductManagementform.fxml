<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="context" prefHeight="400.0" prefWidth="699.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.devstack.pos.controller.ProductManagementFormController">
   <children>
      <Label layoutX="14.0" layoutY="15.0" text="Product Management" textFill="#ab0404">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Separator layoutX="14.0" layoutY="42.0" prefHeight="4.0" prefWidth="669.0" />
      <Button layoutX="450.0" layoutY="15.0" mnemonicParsing="false" onAction="#BackToDashboardOnAction" prefHeight="25.0" prefWidth="110.0" style="-fx-background-color: #747d8c;" text="← Back" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <Button layoutX="576.0" layoutY="15.0" mnemonicParsing="false" onAction="#NewProductOnAction" prefHeight="25.0" prefWidth="108.0" style="-fx-background-color: #3742fa;" text="+ New Product" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <TextField fx:id="txtCode" editable="false" layoutX="14.0" layoutY="54.0" prefHeight="25.0" prefWidth="139.0" promptText="Product Code" />
      <TextField fx:id="txtDescription" layoutX="168.0" layoutY="54.0" prefHeight="25.0" prefWidth="172.0" promptText="Product Description" />
      <TextField fx:id="txtUnitPrice" layoutX="357.0" layoutY="54.0" prefHeight="25.0" prefWidth="108.0" promptText="Unit Price" />
      <TextField fx:id="txtQty" layoutX="481.0" layoutY="54.0" prefHeight="25.0" prefWidth="203.0" promptText="QTY On hand" />
      <TextField fx:id="txtSearch" layoutX="14.0" layoutY="89.0" prefHeight="25.0" prefWidth="502.0" promptText="Search Product by Description or Code..." />
      <Button fx:id="btnSave" layoutX="539.0" layoutY="89.0" mnemonicParsing="false" onAction="#SaveProductOnAction" prefHeight="25.0" prefWidth="145.0" style="-fx-background-color: #3742fa;" text="Save Product" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
      <TableView fx:id="tblProduct" layoutX="15.0" layoutY="124.0" prefHeight="258.0" prefWidth="669.0">
        <columns>
          <TableColumn fx:id="colCode" prefWidth="100.0" text="Code" />
          <TableColumn fx:id="colDescription" prefWidth="220.0" text="Description" />
          <TableColumn fx:id="colUnitPrice" prefWidth="120.0" text="Unit Price" />
          <TableColumn fx:id="colQty" prefWidth="110.0" text="QTY On Hand" />
          <TableColumn fx:id="colQr" prefWidth="118.0" text="QR Code" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
