<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="context" prefHeight="400.0" prefWidth="699.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.devstack.pos.controller.BackupFormController">
   <children>
      <Label layoutX="14.0" layoutY="15.0" text="System Backups" textFill="#ab0404">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Label>
      <Separator layoutX="14.0" layoutY="42.0" prefHeight="4.0" prefWidth="669.0" />
      <Button layoutX="575.0" layoutY="14.0" mnemonicParsing="false" onAction="#BackToDashboardOnAction" prefHeight="25.0" prefWidth="108.0" style="-fx-background-color: #747d8c;" text="← Back" textFill="WHITE">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>

      <AnchorPane layoutX="150.0" layoutY="100.0" prefHeight="200.0" prefWidth="400.0" style="-fx-background-color: #f1f2f6; -fx-background-radius: 12;">
         <children>
            <Label layoutX="110.0" layoutY="30.0" text="Database Backup" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Label layoutX="40.0" layoutY="75.0" text="Create instant full backup of MySQL tables" textFill="#57606f">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <Button layoutX="120.0" layoutY="120.0" mnemonicParsing="false" onAction="#CreateBackupOnAction" prefHeight="35.0" prefWidth="160.0" style="-fx-background-color: #2e86de;" text="⚡ Generate Backup" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
